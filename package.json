{
  "name": "ma-hunter",
  "version": "0.1.0",
  "private": true,
  "description": "One pane of glass for hunting businesses to acquire: sourcing from marketplaces, a scored deal pipeline, and Gmail outreach with follow-ups. Cloudflare Workers + D1 + R2.",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "dev:api": "node ./node_modules/wrangler/bin/wrangler.js dev --port 8788 --var MOCK:true",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "typecheck": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/typescript/bin/tsc -p worker/tsconfig.json --noEmit",
    "test": "node scripts/test.mjs",
    "demo": "npm run build && node ./node_modules/wrangler/bin/wrangler.js dev --port 8788 --var MOCK:true",
    "deploy": "npm run build && node ./node_modules/wrangler/bin/wrangler.js deploy"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
